<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">true</CopyModOnBuild>
    <Sts2ApiCompat Condition="'$(Sts2ApiCompat)' == ''">0.107.1</Sts2ApiCompat>
    <Sts2Version>$(Sts2ApiCompat)</Sts2Version>
    <Sts2RefsRoot Condition="'$(Sts2RefsRoot)' == ''">$(MSBuildProjectDirectory)\refs\game</Sts2RefsRoot>
    <Sts2RefDir Condition="'$(Sts2ApiCompat)' == '0.107.1'">$(Sts2RefsRoot)\0.107.1</Sts2RefDir>
    <Sts2RefDir Condition="'$(Sts2ApiCompat)' == '0.113.0'">$(Sts2RefsRoot)\0.113.0</Sts2RefDir>

    <!-- 仅用于构建后部署，编译引用来自 refs/game/<api-version>。 -->
    <Sts2Dir>D:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir>$(Sts2RefDir)</Sts2DataDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

  </ItemGroup>

  <ItemGroup Condition="'$(Sts2ApiCompat)' == '0.107.1'">
    <PackageReference Include="STS2.RitsuLib.Compat.0.107.1" Version="0.6.11" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(Sts2ApiCompat)' == '0.113.0'">
    <PackageReference Include="STS2.RitsuLib" Version="0.6.11" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="StsModBloodywolf.Scripts.Compat" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="loader/**" />
    <EmbeddedResource Remove="loader/**" />
    <None Remove="loader/**" />
  </ItemGroup>

  <Import Project="build\StsModBloodywolf.Sts2Versions.targets" />

  <!-- 自动复制dll和json -->
  <Target Name="Copy Mod" AfterTargets="PostBuildEvent" Condition="'$(CopyModOnBuild)' != 'false'">
    <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
    <MakeDir Directories="$(Sts2Dir)\mods\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
    <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(Sts2Dir)/mods/$(MSBuildProjectName)/" />
  </Target>
</Project>
