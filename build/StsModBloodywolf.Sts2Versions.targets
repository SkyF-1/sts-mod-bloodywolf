<Project>
  <PropertyGroup>
    <DefineConstants Condition="'$(Sts2ApiCompat)' == '0.107.1'">$(DefineConstants);STS2_API_0_107_1</DefineConstants>
    <DefineConstants Condition="'$(Sts2ApiCompat)' == '0.113.0'">$(DefineConstants);STS2_API_0_113_0</DefineConstants>

    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(Sts2ApiCompat)', '0.107.1'))">$(DefineConstants);STS2_AT_LEAST_0_107_1</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(Sts2ApiCompat)', '0.108.0'))">$(DefineConstants);STS2_AT_LEAST_0_108_0</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(Sts2ApiCompat)', '0.109.0'))">$(DefineConstants);STS2_AT_LEAST_0_109_0</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(Sts2ApiCompat)', '0.110.0'))">$(DefineConstants);STS2_AT_LEAST_0_110_0</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(Sts2ApiCompat)', '0.111.0'))">$(DefineConstants);STS2_AT_LEAST_0_111_0</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(Sts2ApiCompat)', '0.113.0'))">$(DefineConstants);STS2_AT_LEAST_0_113_0</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateSts2ApiCompat" BeforeTargets="PrepareForBuild;CoreCompile">
    <Error
      Condition="'$(Sts2ApiCompat)' != '0.107.1' and '$(Sts2ApiCompat)' != '0.113.0'"
      Text="Unsupported Sts2ApiCompat '$(Sts2ApiCompat)'. Add an explicit package, reference set, and compatibility branch." />
  </Target>

  <Target Name="ValidateSts2References" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="'$(Sts2RefDir)' == ''"
      Text="Sts2RefDir is empty for Sts2ApiCompat '$(Sts2ApiCompat)'." />
    <Error
      Condition="!Exists('$(Sts2RefDir)\sts2.dll')"
      Text="Missing game reference: '$(Sts2RefDir)\sts2.dll'." />
    <Error
      Condition="!Exists('$(Sts2RefDir)\0Harmony.dll')"
      Text="Missing Harmony reference: '$(Sts2RefDir)\0Harmony.dll'." />
    <Error
      Condition="!Exists('$(Sts2RefDir)\release_info.json')"
      Text="Missing reference provenance: '$(Sts2RefDir)\release_info.json'." />
  </Target>
</Project>
